<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Transitive Godot analyzers need the owning Godot project path in test builds. -->
    <GodotProjectDir>$(MSBuildProjectDirectory)\..\</GodotProjectDir>
    <!-- This assembly contains only xUnit tests, never Godot script classes. -->
    <GodotDisabledSourceGenerators>ScriptPathAttributeGenerator;GodotPluginsInitializer</GodotDisabledSourceGenerators>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpireEconomy.csproj" />
    <AdditionalFiles Include="..\SpireEconomy\localization\**\*.json" />
  </ItemGroup>
</Project>
